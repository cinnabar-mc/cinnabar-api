{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cinnabar-api",
  "account_id": "a16be1f911ae0c715166f97c4af654eb",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-29",
  "workers_dev": true,
  "routes": [{ "pattern": "api.cinnabar.gg", "custom_domain": true }],
  "triggers": { "crons": ["* * * * *"] },
  // Deploys mirror catalog assets here (scripts/sync-static-assets.mjs); Cloudflare serves matching files without invoking
  // the Worker, and every other path, including assets published after the deploy, falls through to it.
  "assets": { "directory": "./static", "html_handling": "none", "not_found_handling": "none" },
  // Invocation logs would record request metadata such as client IPs, which the API promises not to keep.
  "observability": { "enabled": false },
  "vars": {
    "MOD_RELEASE_REPOSITORY": "cinnabar-mc/cinnabar-client",
    "MOD_RELEASE_PACKAGE": "cinnabar-client-mod",
    "MOD_DOWNLOAD_BASE_URL": "https://api.cinnabar.gg",
    "MOD_HOST_REPOSITORY": "https://github.com/cinnabar-mc/cinnabar.git",
    "COSMETICS_REPOSITORY_ID": "1426158837",
    "COSMETICS_ADMIN_WORKFLOW": "cinnabar-mc/cinnabar-cosmetics/.github/workflows/entitlements.yml@refs/heads/main",
    // The website origin allowed to call marketplace routes with credentials and to receive sign-in returns.
    "MARKETPLACE_ORIGIN": "https://cinnabar.gg",
    "GOOGLE_CLIENT_ID": "662205004327-ea4m7qoli4fdnulrcash7q9in385s557.apps.googleusercontent.com",
    "OWNER_EMAILS": "google@restartfu.com",
    // The authorization service's OIDC issuer for Minecraft multiplayer tokens.
    "ISSUER": "https://authorization.franchise.minecraft-services.net/"
  },
  "analytics_engine_datasets": [{ "binding": "METRICS", "dataset": "cinnabar_api_events" }],
  "r2_buckets": [
    { "binding": "MOD_ASSETS", "bucket_name": "cinnabar-cosmetics" },
    { "binding": "COSMETIC_ASSETS", "bucket_name": "cinnabar-cosmetics" },
    // Submitted mod components, keyed by SHA-256. Create it before deploying: `wrangler r2 bucket create cinnabar-mods`.
    { "binding": "MOD_FILES", "bucket_name": "cinnabar-mods" },
    { "binding": "API_CACHE", "bucket_name": "cinnabar-api-cache" }
  ],
  "durable_objects": {
    "bindings": [{ "name": "HUB", "class_name": "Hub" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }]
}
