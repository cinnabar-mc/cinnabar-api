{
  "compilerOptions": {
    "target": "es2024", "lib": ["es2024", "dom"], "module": "esnext", "moduleResolution": "bundler",
    "types": ["node"], "resolveJsonModule": true, "strict": true, "noUncheckedIndexedAccess": true,
    "isolatedModules": true, "noEmit": true, "skipLibCheck": true
  },
  "include": ["*.ts"]
}
